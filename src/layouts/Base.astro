---
import '@/styles/global.css';
import { site, nav } from '@/site.config';

interface Props {
  title?: string;
  description?: string;
  /** Nav item to mark current, e.g. "/threats". */
  section?: string;
  /** Set false on wide data pages that manage their own container. */
  contained?: boolean;
}

const { title, description = site.description, section, contained = true } = Astro.props;
const pageTitle = title ? `${title} · ${site.short}` : `${site.name}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (href: string) => (href === '/' ? `${base}/` : `${base}${href}`);
const current = section ?? new URL(Astro.request.url).pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap"
    />
    <script is:inline>
      // Apply the stored theme before first paint so there is no flash.
      try {
        const t = localStorage.getItem('osprey-theme');
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
      } catch (e) { /* storage unavailable — fall back to system */ }
    </script>
  </head>

  <body>
    <a href="#main" class="skip">Skip to content</a>

    <header class="masthead">
      <div class="shell mast-in">
        <a href={url('/')} class="brand">
          <span class="mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M12 2.5 3.5 6.5v6c0 5 3.6 8.3 8.5 9.5 4.9-1.2 8.5-4.5 8.5-9.5v-6L12 2.5Z" />
              <circle cx="12" cy="12" r="3.1" />
              <path d="M12 6.6v2.3M12 15.1v2.3M6.6 12h2.3M15.1 12h2.3" />
            </svg>
          </span>
          <span class="brand-txt">
            <b>OSPREY</b>
            <em>Governance Portal</em>
          </span>
        </a>

        <nav class="nav" aria-label="Primary">
          {nav.map((n) => {
            const active = n.exact ? current === '/' : current.startsWith(n.href);
            return (
              <a href={url(n.href)} aria-current={active ? 'page' : undefined}>{n.label}</a>
            );
          })}
        </nav>

        <button id="theme" class="theme" type="button" aria-label="Switch colour theme">
          <svg class="sun" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7">
            <circle cx="12" cy="12" r="4.2" /><path d="M12 2v2.4M12 19.6V22M2 12h2.4M19.6 12H22M4.9 4.9l1.7 1.7M17.4 17.4l1.7 1.7M19.1 4.9l-1.7 1.7M6.6 17.4l-1.7 1.7" />
          </svg>
          <svg class="moon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7">
            <path d="M20 14.2A8.2 8.2 0 0 1 9.8 4a8.4 8.4 0 1 0 10.2 10.2Z" />
          </svg>
        </button>
      </div>
    </header>

    <main id="main">
      {contained ? <div class="shell"><slot /></div> : <slot />}
    </main>

    <footer class="foot">
      <div class="shell foot-in">
        <div class="foot-col">
          <p class="foot-brand">OSPREY Governance Portal</p>
          <p class="foot-note">
            A supplement to the Agentic Governance &amp; Security Controls (AGSC) standard, not a
            replacement for it. AGSC provides the control catalogue this portal anchors to; the
            portal adds the runtime threat layer, the EC-Council ADG mapping, and the evaluation
            evidence that shows whether the controls are operating.
          </p>
        </div>
        <div class="foot-col">
          <p class="label">Anchored to</p>
          <ul class="foot-list">
            <li>AGSC — COHUMAIN Labs &amp; SafeAlign AI</li>
            <li>ADG — EC-Council Global Services</li>
            <li>OWASP GenAI Security Project</li>
            <li>MITRE ATLAS</li>
            <li>EU AI Act · NIST AI RMF · ISO/IEC 42001</li>
          </ul>
        </div>
        <div class="foot-col">
          <p class="label">This site</p>
          <ul class="foot-list">
            <li><a href={url('/frameworks')}>Framework versions in use</a></li>
            <li><a href={url('/changelog')}>Changelog</a></li>
            <li><a href={url('/notes/how-to-read-this')}>How to read this</a></li>
          </ul>
          <p class="foot-note small">
            Every framework reference on this site carries the version it was validated against.
            Content is a work in progress and expands as the project does.
          </p>
        </div>
      </div>
    </footer>

    <script is:inline>
      const btn = document.getElementById('theme');
      btn?.addEventListener('click', () => {
        const root = document.documentElement;
        const now =
          root.dataset.theme ??
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = now === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('osprey-theme', next); } catch (e) { /* ignore */ }
      });
    </script>

    <style>
      .skip {
        position: absolute; left: -9999px; top: 8px; z-index: 100;
        background: var(--panel); color: var(--ink); padding: 8px 14px;
        border: 1px solid var(--accent); border-radius: var(--r-md);
      }
      .skip:focus { left: 16px; }

      .masthead {
        position: sticky; top: 0; z-index: 40;
        background: color-mix(in srgb, var(--ground) 88%, transparent);
        backdrop-filter: saturate(1.6) blur(8px);
        border-bottom: 1px solid var(--rule);
      }
      .mast-in { display: flex; align-items: center; gap: var(--sp-5); min-height: 58px; }

      .brand { display: flex; align-items: center; gap: 9px; text-decoration: none; color: var(--ink); flex: none; }
      .mark { color: var(--accent); display: flex; }
      .brand-txt { display: flex; flex-direction: column; line-height: 1.05; }
      .brand-txt b { font-family: var(--f-display); font-weight: 700; font-size: 16px; letter-spacing: .01em; }
      .brand-txt em {
        font-style: normal; font-family: var(--f-mono); font-size: 9.5px;
        letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3); margin-top: 2px;
      }

      .nav { display: flex; gap: 2px; margin-left: auto; flex-wrap: wrap; }
      .nav a {
        font-size: 13.5px; color: var(--ink-2); text-decoration: none;
        padding: 6px 10px; border-radius: var(--r-sm); white-space: nowrap;
      }
      .nav a:hover { color: var(--ink); background: var(--panel-2); }
      .nav a[aria-current='page'] { color: var(--ink); background: var(--panel-2); font-weight: 600; }

      .theme {
        flex: none; display: grid; place-items: center; width: 32px; height: 32px;
        background: var(--panel); color: var(--ink-2);
        border: 1px solid var(--rule); border-radius: var(--r-sm); cursor: pointer;
      }
      .theme:hover { color: var(--ink); border-color: var(--accent); }
      .theme .moon { display: none; }
      :root[data-theme='dark'] .theme .sun { display: none; }
      :root[data-theme='dark'] .theme .moon { display: block; }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) .theme .sun { display: none; }
        :root:not([data-theme='light']) .theme .moon { display: block; }
      }

      @media (max-width: 900px) {
        .mast-in { flex-wrap: wrap; padding-top: 10px; padding-bottom: 10px; gap: var(--sp-3); }
        .nav { order: 3; width: 100%; margin-left: 0; }
        .theme { margin-left: auto; }
      }

      main { min-height: 60vh; padding-bottom: var(--sp-8); }

      .foot { border-top: 1px solid var(--rule); background: var(--panel); margin-top: var(--sp-8); }
      .foot-in {
        display: grid; grid-template-columns: 1.7fr 1fr 1fr;
        gap: var(--sp-6); padding: var(--sp-6) var(--sp-5);
      }
      @media (max-width: 820px) { .foot-in { grid-template-columns: 1fr; gap: var(--sp-5); } }
      .foot-brand { font-family: var(--f-display); font-weight: 600; font-size: 15px; margin-bottom: 6px; }
      .foot-note { font-size: 13px; color: var(--ink-2); max-width: 52ch; }
      .foot-note.small { font-size: 12px; margin-top: 10px; color: var(--ink-3); }
      .foot-list { list-style: none; margin: 8px 0 0; padding: 0; font-size: 13px; color: var(--ink-2); }
      .foot-list li + li { margin-top: 5px; }
    </style>
  </body>
</html>
