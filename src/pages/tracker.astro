---
import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import { url } from '@/lib/data';

interface Workstream {
  id: string;
  name: string;
  owners: string;
  status: 'in-progress' | 'planned' | 'stable';
  deliverables: string[];
  dependency: string;
}

const workstreams: Workstream[] = [
  {
    id: 'WS-1',
    name: 'Telemetry Ingest, Normalization & Environment Readiness',
    owners: 'Danial',
    status: 'in-progress',
    deliverables: [
      'Parse and normalize flat workbook extracts for Datasets A, B, C, and D into clean tabular formats (osprey_data_ingest_v0).',
      'Normalize column names, coerce data types, remove workbook title/header artifacts, and flag malformed timestamps in a data-quality log.',
      'Environment smoke test: validate GCP, DGX Spark GPU sandbox, code repository, and Python execution environments.',
      'Exploration: benchmark explainable clustering-based behavioral anomaly detection (Isolation Forest / Mahalanobis outlier detection) as a lightweight Detect baseline.',
    ],
    dependency: 'Blocks downstream feature extraction and model fine-tuning environments.',
  },
  {
    id: 'WS-2',
    name: 'Sequence Feature Layer & Canonical Crosswalk',
    owners: 'Tarun',
    status: 'in-progress',
    deliverables: [
      'Deliver OSPREY Canonical Taxonomy Crosswalk v0.1 reconciling inconsistent threat labels across Datasets A, B, C, and D.',
      'Decompose agent_id into behavioral unit (agent_role) and deployment unit (agent_instance), unblocking scenario joins.',
      'Derive synthetic event_time from monotonic ID suffix and flag synthetic_time = true.',
      'Engineer multi-event sequence features grouped on (pipeline_id, agent_role, stage) with sliding n-grams and Markov transition matrices to unlock the 34.6% sequence anomalies (Finding 2).',
    ],
    dependency: 'Requires WS-1 normalized event feeds; unblocks WS-3 sequence evaluation.',
  },
  {
    id: 'WS-3',
    name: 'Detect Baseline & Honest Evaluation Harness',
    owners: 'Ali',
    status: 'in-progress',
    deliverables: [
      'Build OSPREY Detect Eval Harness v0.1 using Dataset A with output_classification as the binary label.',
      'Mandatory single-feature rule-baseline comparator: evaluate latency_ms > 320 and confidence_score < 0.90 alongside every model result.',
      'Report full confusion matrix, F1, recall, FNR, FPR, and per-class recall across all anomaly_type values.',
      'Enforce evaluation discipline: strictly mark synthetic workbook scores as internal plumbing checks only — no Gate 1 promotion pass on synthetic data.',
    ],
    dependency: 'Requires WS-1 normalized labels and WS-2 sequence feature groups.',
  },
  {
    id: 'WS-4',
    name: 'Feature Contract, Policy Harness & MOM Assistant Portal',
    owners: 'Mansi',
    status: 'in-progress',
    deliverables: [
      'Document OSPREY Feature Contract v0.1: explicitly whitelist model features and purge label leakages (policy_gate_verdict, threat_detected, output_classification).',
      'Define OSPREY Policy Harness Stub v0.1: create verdict schema, decision log, structured audit justification artifact, and evidence output for SafeAlign OPA bundle.',
      'Deliver MOM Assistant frontend dashboard (Detect & Quarantine Overview, KPIs, anomaly distribution, vertical breakdown, live event feed with SYNTHETIC badges).',
      'Implement FastAPI dashboard backend (GET /events/recent, GET /events/queue, GET /pipelines/summary, POST /events/{event_id}/review) for model feed and human-in-the-loop review routing.',
    ],
    dependency: 'Independent build; connects to WS-1/WS-3 model telemetry and feeds MOM reviewer queues.',
  },
  {
    id: 'WS-5',
    name: 'Dataset C Control Rebuild & Dataset D Gym Isolation',
    owners: 'Joint (MLA Team & SafeAlign / Himanshu)',
    status: 'in-progress',
    deliverables: [
      'Rebuild Dataset C control mapping table: assign stable alphanumeric IDs, retire Bill C-27 / AIDA, and remap to OWASP Top 10 for LLM 2025 and PIPEDA / OSFI E-23.',
      'Partition Dataset D into disjoint technique pools: CyberGym (known technique families for Gate 1 eval) vs ExploitGym (held-out novel families for containment testing).',
      'Validate regenerated synthetic extract v2 containing ~35% benign / near-miss negative scenarios.',
    ],
    dependency: 'Coordinated with SafeAlign data engineering team (Himanshu Joshi).',
  },
];

interface Escalation {
  item: string;
  whyBlocks: string;
  owner: string;
  targetDate: string;
  status: 'active' | 'in-progress' | 'pending';
}

const escalations: Escalation[] = [
  {
    item: 'GCP & DGX Spark Sandbox Credentials',
    whyBlocks: 'Blocks on-premise fine-tuning environment setup, QLoRA 4-bit Unsloth scripts, and GPU memory profiling for Tier 1 SLMs.',
    owner: 'Himanshu / Ehsan / Danial',
    targetDate: '15 Sep 2026',
    status: 'active',
  },
  {
    item: 'Regenerated Synthetic Extract v2',
    whyBlocks: 'Overcomes the D-01 latency shortcut (overlapping latency distributions), provides ~35% negatives in D, and fixes the model roster in B.',
    owner: 'SafeAlign Data Team / Himanshu',
    targetDate: '16 Sep 2026',
    status: 'active',
  },
  {
    item: 'Draft OPA Policy Bundle (FSI First)',
    whyBlocks: 'Provides real enterprise Rego rules to replace the WS-4 mock bundle, enforcing deterministic policy-as-code gate verdicts.',
    owner: 'Himanshu Joshi',
    targetDate: '18 Sep 2026',
    status: 'in-progress',
  },
  {
    item: 'Real Production Telemetry Cohort',
    whyBlocks: 'Synthetic data cannot clear Gate 1. Real trace streams (trace_id, session_id, tool payloads) needed for defensible model validation and Gate 2 shadow promotion.',
    owner: 'Himanshu (Anchor Client)',
    targetDate: '22 Sep 2026',
    status: 'pending',
  },
];
---

<Base
  title="Sprint Execution Tracker"
  section="/tracker"
  description="Operational sprint execution tracker and architecture reference for Project OSPREY: translating crosswalk alignment into weekly build workstreams, paired with v4 runtime and evaluation blueprints."
  contained={false}
>
  <div class="shell">
    <PageHeader
      eyebrow="Execution & Architecture Hub"
      title="Sprint execution plan & architecture reference"
      lede="Live operational hub for Project OSPREY. This page tracks weekly sprint progress, active engineering workstreams, and dependency escalations, grounded in the settled four-dataset crosswalk and the v4 architecture blueprints."
      facts={[
        { k: 'Current Sprint', v: 'Sprint 3 (Sept 14–18)' },
        { k: 'Operating Phase', v: 'Phase 3 (Build & Pipeline)' },
        { k: 'MLA Team', v: 'Danial · Ali · Tarun · Mansi' },
        { k: 'Technical Lead', v: 'Ehsan' },
        { k: 'Functional Manager', v: 'Dhari Gandhi' },
      ]}
    />

    <!-- Sprint Progression Timeline & Workstreams -->
    <section class="sec">
      <div class="sec-head">
        <h2>Sprint progression &amp; active build workstreams</h2>
        <p class="sub">
          Weekly sprint status tracking what was completed, what is actively being built, and upcoming milestones.
        </p>
      </div>

      <div class="sprint-grid">
        <!-- Sprint 2 Summary Card -->
        <article class="panel sprint-card sprint-card--done">
          <div class="sprint-card-header">
            <div>
              <span class="pill" data-status="stable">Sprint 2 · Completed</span>
              <h3 class="sprint-title">Foundation &amp; Data Validation</h3>
              <p class="sprint-dates mono">Aug 31 – Sep 11, 2026</p>
            </div>
            <span class="sprint-badge">Sign-off Complete</span>
          </div>

          <div class="sprint-body">
            <h4 class="subhead">Accomplishments &amp; Grounding Deliverables</h4>
            <ul class="check-list">
              <li><strong>Canonical Threat Taxonomy:</strong> Codified the 16 standard threat buckets (<code>OSP-01…16</code>) aligned with AGSC and MITRE ATLAS.</li>
              <li><strong>Four-Dataset Crosswalk:</strong> Successfully mapped all 10,040 sample records across Datasets A, B, C, and D into canonical buckets.</li>
              <li><strong>12 Settled Architectural Decisions:</strong> Enforced training vs evaluation boundaries, deterministic timestamps, and no A↔B join.</li>
              <li><strong>Two Critical Discoveries:</strong> Uncovered the synthetic latency shortcut (F1 = 0.979) and the 34.6% sequence property blindspot.</li>
              <li><strong>16 Data Defects Cataloged:</strong> Categorized defects D-01 through D-16 across P1, P2, and P3 priorities with clear operational owners.</li>
            </ul>
          </div>
        </article>

        <!-- Sprint 3 Active Card -->
        <article class="panel sprint-card sprint-card--active">
          <div class="sprint-card-header">
            <div>
              <span class="pill" data-status="in-progress">Sprint 3 · Active Build</span>
              <h3 class="sprint-title">Pipeline Ingest &amp; Feature Layer</h3>
              <p class="sprint-dates mono">Sep 14 – Sep 18, 2026</p>
            </div>
            <span class="sprint-badge sprint-badge--active">Current Focus</span>
          </div>

          <div class="sprint-body">
            <div class="callout-mandate-banner">
              <strong>Sprint 3 Core Mandate:</strong> "Build the pipeline, not the proof." Deliver the ingest normalizer, sequence feature extractor, dual-scoring eval harness, and OPA policy stub.
            </div>

            <div class="workstreams-wrap">
              {workstreams.map((ws) => (
                <div class="ws-block" id={ws.id.toLowerCase()}>
                  <div class="ws-top">
                    <div class="ws-meta">
                      <span class="chip chip--accent"><span class="k">{ws.id}</span>{ws.name}</span>
                      <span class="ws-owners mono">Owners: {ws.owners}</span>
                    </div>
                    <span class="pill" data-status={ws.status}>{ws.status.replace('-', ' ')}</span>
                  </div>
                  <ul class="ws-tasks">
                    {ws.deliverables.map((d) => (
                      <li>{d}</li>
                    ))}
                  </ul>
                  <p class="ws-dep mono"><strong>Dependency:</strong> {ws.dependency}</p>
                </div>
              ))}
            </div>
          </div>
        </article>

        <!-- Sprint 4+ Lookahead Card -->
        <article class="panel sprint-card sprint-card--future">
          <div class="sprint-card-header">
            <div>
              <span class="pill" data-status="planned">Sprint 4–7 · Lookahead</span>
              <h3 class="sprint-title">Fine-Tuning, Quarantine &amp; Full Loop</h3>
              <p class="sprint-dates mono">Sep 21 – Oct 30, 2026</p>
            </div>
            <span class="sprint-badge sprint-badge--future">Roadmap</span>
          </div>

          <div class="sprint-body">
            <div class="roadmap-phases">
              <div class="phase-item">
                <span class="phase-badge mono">P3 · Classify</span>
                <div>
                  <strong>SLM Fine-Tuning &amp; Gate 1 (Wk 5–6):</strong>
                  <p>Fine-tune Mistral 7B / Cohere on DGX Spark using normalized telemetry. Evaluate Gate 1 against CyberGym golden pool (F1 &ge; 0.82 &rarr; 0.88).</p>
                </div>
              </div>
              <div class="phase-item">
                <span class="phase-badge mono">P4 · Quarantine</span>
                <div>
                  <strong>Automated Policy Quarantine (Wk 7–8):</strong>
                  <p>Connect Harness policy gates to live OPA bundle. Sub-60s autonomous isolation for high-confidence threats; FNR &lt; 5% on critical threats.</p>
                </div>
              </div>
              <div class="phase-item">
                <span class="phase-badge mono">P5 · Act &amp; Repair</span>
                <div>
                  <strong>Frontier Claude Escalation &amp; Attestation (Wk 9–10):</strong>
                  <p>Incorporate Tier 2 Claude escalation for high-severity/OOD events. Connect MOM human reviewer queues and auto-remediation patches.</p>
                </div>
              </div>
            </div>
          </div>
        </article>
      </div>
    </section>

    <!-- Sprint 2 Retro & Architecture Resolutions -->
    <section class="sec" id="retro-resolutions">
      <div class="sec-head">
        <h2>Sprint 2 Retro &amp; Key Architecture Resolutions</h2>
        <p class="sub">
          Grounded engineering resolutions for technical questions raised during Sprint 2 retrospective, governing our Sprint 3 build choices.
        </p>
      </div>

      <div class="retro-grid">
        <!-- Resolution 1: Clustering-Based Detect Engine -->
        <article class="panel retro-card">
          <div class="retro-card-header">
            <span class="pill" data-status="in-progress">Detect Stage Architecture</span>
            <span class="mono tech-lead">Exploration: Danial</span>
          </div>
          <h3 class="retro-title">Clustering-Based Behavioral Anomaly Detection vs. SLM Baselining</h3>
          <p class="prose-txt">
            <strong>Retrospective Inquiry:</strong> <em>"Can we implement a clustering based technique to identify anomalies in Detect phase rather than using an SLM for extracting behavioural baseline anomalies? Won't this be a more cleaner and explainable approach?"</em>
          </p>
          <div class="resolution-content">
            <h4 class="subhead">Architecture Assessment &amp; Feasibility</h4>
            <ul class="check-list">
              <li>
                <strong>Explainability by Mathematical Construction:</strong> Unsupervised density and distance clustering (e.g., <em>Isolation Forest</em>, <em>One-Class SVM</em>, or <em>Mahalanobis Distance</em> over continuous telemetry z-scores) provides explicit feature attributions. When an anomaly triggers, the operator receives exact dimensional deviations (e.g., <code>execution_latency</code> was +4.2&sigma; or <code>payload_byte_size</code> deviated 3.8&sigma; from the role baseline centroid), whereas an SLM produces opaque token logprobs.
              </li>
              <li>
                <strong>Inline Latency SLA (&lt;10ms vs ~250ms):</strong> In the v4 runtime operating loop, the <strong>Detect</strong> stage is an inline filter across 100% of event streams. Executing an SLM forward pass on every event creates a severe GPU bottleneck. Clustering algorithms evaluate in sub-10ms on CPU, preserving DGX Spark GPU capacity for the <strong>Classify</strong> stage (Tier 1 Mistral 7B / Cohere).
              </li>
              <li>
                <strong>Decoupled Role-Profile Clustering:</strong> Enabled by Tarun's decomposition of <code>agent_id</code> into <code>agent_role</code> and <code>agent_instance</code>, Danial constructs distinct behavioral clusters per agent role (e.g., <code>patient-intake-agent</code> vs <code>credit-decisioning-agent</code>).
              </li>
              <li>
                <strong>Sprint 3 Implementation:</strong> Danial is implementing this lightweight clustering baseline alongside telemetry normalization in WS-1. In WS-3, Ali benchmarks it directly in the evaluation harness to determine whether it feeds higher-fidelity anomaly scores into Mansi's MOM Assistant dashboard.
              </li>
            </ul>
          </div>
        </article>

        <!-- Resolution 2: Gate 1 Synthetic Constraint & Class Imbalance -->
        <article class="panel retro-card">
          <div class="retro-card-header">
            <span class="pill" data-status="in-progress">Evaluation Discipline</span>
            <span class="mono tech-lead">Harness: Ali &amp; Tarun</span>
          </div>
          <h3 class="retro-title">Gate 1 Synthetic Constraint Mitigation &amp; Sequence Imbalance Resolution</h3>
          <p class="prose-txt">
            <strong>Retrospective Inquiry:</strong> <em>"Will the synthetic data used in Dataset A be a constraint in Gate 1 evaluation passing? How do we plan on mitigating this? How do we do class imbalance resolution for Finding 2 and sequence versus point properties of anomalies?"</em>
          </p>
          <div class="resolution-content">
            <h4 class="subhead">Mitigation &amp; Imbalance Resolution Strategy</h4>
            <ul class="check-list">
              <li>
                <strong>The Synthetic Constraint Reality:</strong> Yes, Dataset A contains Defect D-01 (the synthetic latency shortcut where <code>latency_ms &gt; 320</code> yields F1 = 0.979) and Defect D-07 (untracked session IDs). Consequently, <strong>no Gate 1 pass may be declared on Dataset A</strong>.
              </li>
              <li>
                <strong>Plumbing vs Proof Boundary:</strong> In Sprint 3, Dataset A is restricted strictly to <em>internal pipeline plumbing, feature contract sanity checks, and baseline harness wiring</em>. True Gate 1 promotion will be evaluated exclusively on <strong>CyberGym (Dataset D)</strong> and the regenerated v2 synthetic extract (~35% realistic negatives).
              </li>
              <li>
                <strong>Mandatory Rule-Baseline Comparator:</strong> In the WS-3 harness, every model score is printed side-by-side with the single-feature threshold rule baseline (<code>latency_ms &gt; 320</code>). A model must demonstrate significant margin on semantic features alone to be valid.
              </li>
              <li>
                <strong>Resolving Finding 2 (34.6% Sequence Anomalies across 3 Classes):</strong>
                Three anomaly classes (<code>tool_chain_deviation</code>, <code>inter_agent_hijack</code>, <code>session_hijack</code>) account for 299 of 865 anomalies and are structurally unlearnable on isolated point rows.
                We resolve this through:
                <ol style="margin-top: 6px; padding-left: 1.2em; display: flex; flex-direction: column; gap: 4px;">
                  <li><em>Session Partitioning:</em> Grouping events by <code>(pipeline_id, agent_role, stage)</code> ordered by derived <code>event_time</code>.</li>
                  <li><em>Transition Probability Modeling:</em> Constructing Markov transition matrices and sliding 3-gram/5-gram windows.</li>
                  <li><em>Two-Stream Evaluation:</em> Reporting Point-Wise F1 (argument/prompt anomalies) separately from Sequence-Wise F1 (trajectory/state anomalies) so point accuracy cannot mask a sequence blindspot.</li>
                </ol>
              </li>
            </ul>
          </div>
        </article>

        <!-- Resolution 3: MOM Assistant Frontend & FastAPI Backend -->
        <article class="panel retro-card retro-card--full">
          <div class="retro-card-header">
            <span class="pill" data-status="stable">Operational Interface</span>
            <span class="mono tech-lead">Build: Mansi</span>
          </div>
          <h3 class="retro-title">MOM Assistant Frontend Portal &amp; FastAPI Backend Architecture</h3>
          <p class="prose-txt">
            <strong>Retrospective Inquiry:</strong> <em>"Mansi is working on the front end portal for MOM and linking it to the backend of the phases using FastAPIs for fetching feed from the models and it will look something like the images attached."</em>
          </p>

          <div class="mom-showcase-grid">
            <div class="mom-card">
              <div class="mom-img-wrap">
                <img
                  src={url('/mom/mom-dashboard-overview.png')}
                  alt="MOM Assistant Governance Overview Dashboard showing Detect & Quarantine KPIs and Live Event Feed"
                  class="mom-img"
                  loading="lazy"
                />
              </div>
              <div class="mom-details">
                <h4 class="subhead">1. MOM Assistant Governance Dashboard (UI Overview)</h4>
                <p class="prose-txt">
                  The primary Human-in-the-Loop (HITL) interface for security operators, connecting real-time model outputs with policy enforcement.
                </p>
                <ul class="check-list" style="margin-top: 8px;">
                  <li><strong>KPI Telemetry Cards:</strong> Real-time tracking of Total Events (6), Anomalies Flagged (3), Pending Review (3), and Gate-Passed (3).</li>
                  <li><strong>Anomaly Type Distribution:</strong> Live categorical breakdown (<code>none</code> 50%, <code>data_exfiltration</code> 16.7%, <code>context_poisoning</code> 16.7%, <code>prompt_injection</code> 16.7%).</li>
                  <li><strong>Events by Vertical:</strong> Normalized distribution across Pharma (33.3%), Retail (33.3%), and FSI (33.3%).</li>
                  <li><strong>Live Event Feed:</strong> Displays event timestamps with <code>SYNTHETIC</code> badges, decomposed pipeline IDs, agent roles (e.g., <code>patient-intake-agent 05</code>, <code>fraud-review-agent 11</code>, <code>credit-decisioning-agent 03</code>), tools, confidence ratings, and automated verdicts (<code>QUARANTINE_TRIGGERED</code> vs <code>PASS</code>).</li>
                </ul>
              </div>
            </div>

            <div class="mom-card">
              <div class="mom-img-wrap">
                <img
                  src={url('/mom/mom-fastapi-swagger.png')}
                  alt="MOM Assistant Dashboard API 0.1.0 Swagger documentation showing REST endpoints"
                  class="mom-img"
                  loading="lazy"
                />
              </div>
              <div class="mom-details">
                <h4 class="subhead">2. FastAPI Dashboard Backend (OpenAPI 3.1 Contract)</h4>
                <p class="prose-txt">
                  High-performance asynchronous REST API connecting the Detect/Classify pipeline, OPA policy stub, and MOM reviewer queues.
                </p>
                <div class="endpoint-list">
                  <div class="endpoint-item">
                    <span class="http-badge http-get mono">GET</span>
                    <code>/events/recent</code>
                    <span>Streams recent pipeline telemetry events to the live overview feed.</span>
                  </div>
                  <div class="endpoint-item">
                    <span class="http-badge http-get mono">GET</span>
                    <code>/events/queue</code>
                    <span>Retrieves quarantined events requiring human-in-the-loop review.</span>
                  </div>
                  <div class="endpoint-item">
                    <span class="http-badge http-get mono">GET</span>
                    <code>/pipelines/summary</code>
                    <span>Calculates aggregate event volume, anomaly ratios, and health metrics.</span>
                  </div>
                  <div class="endpoint-item">
                    <span class="http-badge http-post mono">POST</span>
                    <code>/events/{'{'}event_id{'}'}/review</code>
                    <span>Records operator review decisions (<code>ReviewDecision</code>), generating structured audit justification logs.</span>
                  </div>
                </div>
                <p class="foot-note small" style="margin-top: 10px;">
                  Pydantic data schemas: <code>Event</code>, <code>ReviewDecision</code>, <code>PipelineAgentSummary</code>, <code>InstanceBreakdown</code>.
                </p>
              </div>
            </div>
          </div>
        </article>
      </div>
    </section>

    <!-- Architecture Reference Hub -->
    <section class="sec">
      <div class="sec-head">
        <h2>Architecture Reference Hub (v4 Blueprints)</h2>
        <p class="sub">
          Official architecture blueprints grounding the OSPREY platform: the continuous runtime operating loop and the multi-phase build &amp; evaluation promotion cycle.
        </p>
      </div>

      <!-- Diagram 1: Runtime Operating Loop -->
      <article class="panel arch-card">
        <div class="arch-card-header">
          <div class="arch-title-group">
            <span class="label">Artboard 1 · Runtime Architecture</span>
            <h3>The Five-Stage Operating Loop &amp; Two-Tier Model Split</h3>
          </div>
          <a href={url('/diagrams/runtime-loop-v4.png')} target="_blank" rel="noopener noreferrer" class="chip chip--accent">
            View Full Resolution ↗
          </a>
        </div>

        <div class="diagram-display">
          <img
            src={url('/diagrams/runtime-loop-v4.png')}
            alt="OSPREY Runtime Architecture showing the five-stage operating loop and two-tier model hierarchy"
            class="arch-img"
            loading="lazy"
          />
        </div>

        <div class="arch-walkthrough">
          <h4>End-User Architecture Walkthrough</h4>
          <div class="arch-points-grid">
            <div class="arch-point">
              <strong>1. The 5-Stage Operating Loop (Continuous):</strong>
              <p>
                Events move continuously through five security primitives: <strong>Detect</strong> (behavioral baselining &amp; anomaly scoring) →
                <strong>Classify</strong> (semantic taxonomy assignment into OSP-01…16) → <strong>Quarantine</strong> (confidence-gated autonomous isolation) →
                <strong>Act</strong> (SIEM/SOAR incident packets &amp; human escalation) → <strong>Repair</strong> (remediation diffs &amp; compliance attestation).
              </p>
            </div>

            <div class="arch-point">
              <strong>2. Two-Tier Model Split (~95% / ~5%):</strong>
              <p>
                <strong>Tier 1 (On-Prem SLMs):</strong> Handles ~95% of pipeline events on NVIDIA DGX Spark (QLoRA 4-bit via Unsloth) for strict data residency and low latency.
                Lightweight Phi-3/Gemma scores Detect; specialized Mistral 7B/Cohere Command R7B performs Classify.
                <strong>Tier 2 (Frontier Claude):</strong> Escalates high-severity, ambiguous, or out-of-distribution threats in Act &amp; Repair with sanitized context.
              </p>
            </div>

            <div class="arch-point">
              <strong>3. Ingest &amp; Leakage Boundary:</strong>
              <p>
                Sits between raw enterprise event streams and the Detect stage. Enforces deterministic timestamp derivation, splits agent IDs into role + instance, and strictly purges leakage fields (<code>policy_gate_verdict</code> and <code>threat_detected</code>).
              </p>
            </div>

            <div class="arch-point">
              <strong>4. Governance &amp; Security (GS) Wrapper:</strong>
              <p>
                Enforces independent OPA policy-as-code rules, generates one immutable audit justification artifact per decision, maintains human-in-the-loop (HITL) authorization gates, and instruments MOM observability metrics.
              </p>
            </div>
          </div>
        </div>
      </article>

      <!-- Diagram 2: Build & Eval Plan -->
      <article class="panel arch-card">
        <div class="arch-card-header">
          <div class="arch-title-group">
            <span class="label">Artboard 2 · Build &amp; Evaluation Plan</span>
            <h3>7-Phase Roadmap &amp; The Two-Gate Promotion Cycle</h3>
          </div>
          <a href={url('/diagrams/build-eval-plan-v4.png')} target="_blank" rel="noopener noreferrer" class="chip chip--accent">
            View Full Resolution ↗
          </a>
        </div>

        <div class="diagram-display">
          <img
            src={url('/diagrams/build-eval-plan-v4.png')}
            alt="OSPREY Build and Evaluation Plan showing 7 phases, two-gate promotion cycle, and Minimum Viable Defense scope"
            class="arch-img"
            loading="lazy"
          />
        </div>

        <div class="arch-walkthrough">
          <h4>End-User Architecture Walkthrough</h4>
          <div class="arch-points-grid">
            <div class="arch-point">
              <strong>1. The 7 Project Phases:</strong>
              <p>
                Phase progression: <strong>P1 Foundation</strong> (wk 1–2: setup &amp; dataset init) → <strong>P2 Baseline</strong> (wk 3–4: telemetry &amp; Detect operational) →
                <strong>P3 Classify</strong> (wk 5–6: SLM fine-tuning &amp; Gate 1) → <strong>P4 Quarantine</strong> (wk 7–8: sub-60s autonomous isolation) →
                <strong>P5 Act &amp; Repair</strong> (wk 9–10: Claude escalation &amp; Gate 2) → <strong>P6 Compliance</strong> (wk 11–12: audit attestation) →
                <strong>P7 Production</strong> (wk 13–14+: shadow eval &amp; CI/CD promotion).
              </p>
            </div>

            <div class="arch-point">
              <strong>2. Disjoint CyberGym &amp; ExploitGym Separation:</strong>
              <p>
                Dataset D scenarios are separated by construction: <strong>CyberGym</strong> draws known technique families to test in-distribution classification accuracy (training-safe);
                <strong>ExploitGym</strong> draws held-out technique families and novel compositions to test pipeline containment rate (eval-only, isolated). Never random-split.
              </p>
            </div>

            <div class="arch-point">
              <strong>3. Two-Gate Model Promotion Cycle:</strong>
              <p>
                <strong>Gate 1 (CyberGym):</strong> Requires F1 &ge; 0.88 on golden test set and FNR &lt; 5% on critical threats. A model failing Gate 1 triggers mandatory rewrite and returns to fine-tuning.
                <strong>Gate 2 (Prod Shadow):</strong> Validates live production telemetry performance, human reviewer acceptance $\ge 90\%$, and latency SLA compliance.
              </p>
            </div>

            <div class="arch-point">
              <strong>4. Minimum Viable Defense (MVD) Scope:</strong>
              <p>
                <strong>In Scope:</strong> Canonical taxonomy crosswalk, ingest feature contract, sequence feature layer, rule-baseline eval harness, negative scenario generation, Dataset C rebuild, and policy stub harness.
                <strong>Out of Scope:</strong> Declaring Gate 1 pass on synthetic data, fine-tuning on Dataset B, publishing premature MTTD/MTTQ numbers, or Claude escalation (deferred to Phase 5).
              </p>
            </div>
          </div>
        </div>
      </article>
    </section>

    <!-- Active Escalations & Dependencies -->
    <section class="sec">
      <div class="sec-head">
        <h2>Active Dependencies &amp; External Escalations</h2>
        <p class="sub">
          Critical platform requirements actively tracked with SafeAlign lead Himanshu Joshi and client stakeholders.
        </p>
